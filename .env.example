# Copy this file to .env and fill in from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Sign up free at mapbox.com/signup, then copy the default public token
# from your Account page. Powers map tiles + location geocoding across the
# Alumni Map, Business Directory, Jobs and Events. Free tier covers 100k
# geocoding requests and 50k map loads per month.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Canonical public URL of the live site, e.g. https://eendragalumni.com
# Optional. When set, it's where Supabase sends people back to after a
# Google sign-in or a password-reset link, instead of whatever origin the
# page happened to be served from. Without it, a reset requested from a
# Vercel preview deployment emails a link back to that preview build.
# Leave it unset locally so redirects come back to localhost.
# Whatever you set must also be listed under Supabase Dashboard >
# Authentication > URL Configuration > Redirect URLs.
VITE_SITE_URL=

# Cloudflare Turnstile site key (public, safe to expose in the frontend).
# Get it from dash.cloudflare.com > Turnstile. The matching Secret key goes
# in Supabase Dashboard > Authentication > Settings > Bot and Abuse
# Protection > Enable CAPTCHA protection — NOT in this file.
VITE_TURNSTILE_SITE_KEY=0x_your-turnstile-site-key

# Where members are told to write when they need a person: the "under review"
# and "not verified" screens, the footer, the privacy policy. Optional — falls
# back to the current admin's address (src/contact.js). Set the same address
# as the CONTACT_EMAIL secret on the Supabase Edge Functions so the emails
# match. A role address (e.g. committee@eendragalumni.org) is better than a
# personal one, since it survives a change of committee.
VITE_CONTACT_EMAIL=
