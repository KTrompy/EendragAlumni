# Copy this file to .env and fill in from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Sign up free at mapbox.com/signup, then copy the default public token
# from your Account page. Powers map tiles + location geocoding across the
# Alumni Map, Business Directory, Jobs and Events. Free tier covers 100k
# geocoding requests and 50k map loads per month.
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Cloudflare Turnstile site key (public, safe to expose in the frontend).
# Get it from dash.cloudflare.com > Turnstile. The matching Secret key goes
# in Supabase Dashboard > Authentication > Settings > Bot and Abuse
# Protection > Enable CAPTCHA protection — NOT in this file.
VITE_TURNSTILE_SITE_KEY=0x_your-turnstile-site-key
